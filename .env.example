# 起步阶段不初始化数据库、缓存或队列；这些变量是后续适配参考。
# 环境选择：development | testing | staging | production | docker
FASTAPI_ENV=development

# 应用
PROJECT_NAME=yiban-api
PROJECT_VERSION=0.1.0
# 调试开关：专用环境变量 YIBAN_DEBUG（避免与通用 DEBUG 环境变量冲突）
YIBAN_DEBUG=true
LOG_LEVEL=DEBUG
API_VERSION=v1
API_PREFIX=/api/v1

# 数据库（同步 URL，运行时会转为 aiomysql）
DATABASE_URL=mysql+pymysql://dev_user:123456@localhost:3306/api_security_demo?charset=utf8mb4

# JWT / 安全（生产必须覆盖）
SECRET_KEY=dev-secret-key-not-for-production-use-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8888","http://127.0.0.1:8888"]
CORS_ALLOW_CREDENTIALS=true

# Redis（可选；cache_enabled=false 时用内存缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=false
CACHE_TTL=300
CACHE_PREFIX=yiban

# 自定义安全中间件（默认关闭）
MIDDLEWARE_SECURITY_HEADERS_ENABLED=false
MIDDLEWARE_RATE_LIMIT_ENABLED=false
MIDDLEWARE_AUDIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20

HOST=127.0.0.1
PORT=8001
