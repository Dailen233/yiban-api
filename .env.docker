# Docker Compose 可选覆盖（项目根目录）
# 用法：docker compose -f docker/docker-compose.yml --env-file .env.docker up --build

FASTAPI_ENV=docker
DEBUG=false
SECRET_KEY=change-me-in-docker-min-32-chars-please
APP_PORT=8000

MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=api_security_demo
MYSQL_USER=dev_user
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# 启用 Redis 时取消注释下一行，并加上 --profile redis
# REDIS_HOST=redis
REDIS_HOST=
REDIS_PUBLISH_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
